# RoboVLA Environment Variables Example
# Copy this file to .env and update values

# System Configuration
ROBOVLA_SYSTEM_DEVICE=cuda:0
ROBOVLA_SYSTEM_MIXED_PRECISION=true

# Model Cache
MODEL_CACHE_DIR=./models
DATA_DIR=./data

# Neo4j Configuration
ROBOVLA_KNOWLEDGE_NEO4J_URI=bolt://localhost:7687
ROBOVLA_KNOWLEDGE_NEO4J_USERNAME=neo4j
ROBOVLA_KNOWLEDGE_NEO4J_PASSWORD=your_password_here

# Server Configuration
ROBOVLA_SERVER_HOST=0.0.0.0
ROBOVLA_SERVER_PORT=8000
ROBOVLA_SERVER_WORKERS=4

# Monitoring
ROBOVLA_MONITORING_WANDB_PROJECT=robo-vla
ROBOVLA_MONITORING_WANDB_ENTITY=your-team

# Logging
ROBOVLA_MONITORING_LOGGING_LEVEL=INFO
ROBOVLA_MONITORING_LOGGING_FILE=./logs/robo_vla.log
